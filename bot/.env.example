# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Куда слать заявки: id чатов через запятую (узнать — /id в нужном чате; бот должен быть в группе)
LEAD_CHAT_IDS=
# Необязательно: отправлять заявки ещё и на сайт (группы + почта сайта). Локально лучше не включать.
# LEAD_API_URL=https://rangauto.ru/api/lead
# Необязательно: on — подбор виджетом (в проде Telegram сейчас запрещает виджеты обычным ботам)
# WIDGETS=on
# Необязательно: свой адрес Bot API, если api.telegram.org недоступен
# TELEGRAM_API_ROOT=
# Необязательно: 1 — тестовый сервер Telegram, где виджеты работают (нужен бот из тестового @BotFather)
# TELEGRAM_TEST_ENV=1
# Необязательно: почта для заявок (в проде задаёт Ad-Reach/infra)
# SMTP_HOST=smtp.timeweb.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# LEAD_EMAIL_TO=rangauto@mail.ru
